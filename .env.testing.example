APP_NAME=TruckBill
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default PHPUnit uses SQLite :memory: via phpunit.xml.
# Use an isolated MySQL database when testing REGEXP-heavy paths,
# app:dbbackup, or Playwright against a persistent schema.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=partload_testing
# DB_USERNAME=partload_test
# DB_PASSWORD=local_test_password

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# Playwright (e2e/) — never point at production
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000
PLAYWRIGHT_USER_EMAIL=
PLAYWRIGHT_USER_PASSWORD=
